<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>pda</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0">
			<x>80.0</x>
			<y>180.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>220.0</x>
			<y>180.0</y>
		</state>
		<state id="2" name="q2">
			<x>400.0</x>
			<y>180.0</y>
		</state>
		<state id="3" name="q3">
			<x>560.0</x>
			<y>180.0</y>
			<final/>
		</state>

		<!--The list of transitions.-->
		<!-- Start -->
		<transition>
			<from>0</from><to>1</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>

		<!-- In q1: Push first half -->
		<transition>
			<from>1</from><to>1</to>
			<read>a</read><pop>Z</pop><push>aZ</push>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>a</read><pop>a</pop><push>aa</push>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>a</read><pop>b</pop><push>ab</push>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>b</read><pop>Z</pop><push>bZ</push>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>b</read><pop>a</pop><push>ba</push>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>b</read><pop>b</pop><push>bb</push>
		</transition>

		<!-- In q1 -> q2: Guess center symbol (do not push or pop stack) -->
		<transition>
			<from>1</from><to>2</to>
			<read>a</read><pop>Z</pop><push>Z</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>b</read><pop>Z</pop><push>Z</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>a</read><pop>a</pop><push>a</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>a</read><pop>b</pop><push>b</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>b</read><pop>a</pop><push>a</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>b</read><pop>b</pop><push>b</push>
		</transition>

		<!-- In q2: Match and pop second half -->
		<transition>
			<from>2</from><to>2</to>
			<read>a</read><pop>a</pop><push/>
		</transition>
		<transition>
			<from>2</from><to>2</to>
			<read>b</read><pop>b</pop><push/>
		</transition>

		<!-- In q2 -> q3: Accept on empty input and stack Z -->
		<transition>
			<from>2</from><to>3</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
	</automaton>
</structure>
