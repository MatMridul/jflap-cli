<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>turing</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0">
			<x>100.0</x>
			<y>200.0</y>
			<initial/>
		</state>
		<state id="1" name="q_seek_right_0">
			<x>260.0</x>
			<y>120.0</y>
		</state>
		<state id="2" name="q_check_right_0">
			<x>440.0</x>
			<y>120.0</y>
		</state>
		<state id="3" name="q_seek_right_1">
			<x>260.0</x>
			<y>280.0</y>
		</state>
		<state id="4" name="q_check_right_1">
			<x>440.0</x>
			<y>280.0</y>
		</state>
		<state id="5" name="q_return_left">
			<x>350.0</x>
			<y>380.0</y>
		</state>
		<state id="6" name="q_accept">
			<x>600.0</x>
			<y>200.0</y>
			<final/>
		</state>

		<!--The list of transitions.-->
		<!-- q0: start -->
		<transition>
			<from>0</from><to>6</to>
			<read/><write/><move>R</move>
		</transition>
		<transition>
			<from>0</from><to>1</to>
			<read>0</read><write/><move>R</move>
		</transition>
		<transition>
			<from>0</from><to>3</to>
			<read>1</read><write/><move>R</move>
		</transition>

		<!-- q1: seek right for 0 -->
		<transition>
			<from>1</from><to>1</to>
			<read>0</read><write>0</write><move>R</move>
		</transition>
		<transition>
			<from>1</from><to>1</to>
			<read>1</read><write>1</write><move>R</move>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read/><write/><move>L</move>
		</transition>

		<!-- q2: check right for 0 (ONLY matches a distinct 0, rejects blank) -->
		<transition>
			<from>2</from><to>5</to>
			<read>0</read><write/><move>L</move>
		</transition>

		<!-- q3: seek right for 1 -->
		<transition>
			<from>3</from><to>3</to>
			<read>0</read><write>0</write><move>R</move>
		</transition>
		<transition>
			<from>3</from><to>3</to>
			<read>1</read><write>1</write><move>R</move>
		</transition>
		<transition>
			<from>3</from><to>4</to>
			<read/><write/><move>L</move>
		</transition>

		<!-- q4: check right for 1 (ONLY matches a distinct 1, rejects blank) -->
		<transition>
			<from>4</from><to>5</to>
			<read>1</read><write/><move>L</move>
		</transition>

		<!-- q5: return left -->
		<transition>
			<from>5</from><to>5</to>
			<read>0</read><write>0</write><move>L</move>
		</transition>
		<transition>
			<from>5</from><to>5</to>
			<read>1</read><write>1</write><move>L</move>
		</transition>
		<transition>
			<from>5</from><to>0</to>
			<read/><write/><move>R</move>
		</transition>
	</automaton>
</structure>
