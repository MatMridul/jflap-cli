<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
	<type>pda</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0">
			<x>80.0</x>
			<y>180.0</y>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>220.0</x>
			<y>120.0</y>
		</state>
		<state id="2" name="q2">
			<x>380.0</x>
			<y>120.0</y>
		</state>
		<state id="3" name="q3">
			<x>380.0</x>
			<y>260.0</y>
		</state>
		<state id="4" name="q4">
			<x>540.0</x>
			<y>180.0</y>
			<final/>
		</state>

		<!--The list of transitions.-->
		<!-- q0 transitions -->
		<transition>
			<from>0</from><to>4</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>0</from><to>1</to>
			<read>a</read>
			<pop>Z</pop>
			<push>aZ</push>
		</transition>
		<transition>
			<from>0</from><to>3</to>
			<read>c</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>

		<!-- q1 transitions (pushing a) -->
		<transition>
			<from>1</from><to>1</to>
			<read>a</read>
			<pop>a</pop>
			<push>aa</push>
		</transition>
		<transition>
			<from>1</from><to>2</to>
			<read>b</read>
			<pop>a</pop>
			<push/>
		</transition>

		<!-- q2 transitions (popping a on b) -->
		<transition>
			<from>2</from><to>2</to>
			<read>b</read>
			<pop>a</pop>
			<push/>
		</transition>
		<transition>
			<from>2</from><to>4</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>2</from><to>3</to>
			<read>c</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>

		<!-- q3 transitions (reading c) -->
		<transition>
			<from>3</from><to>3</to>
			<read>c</read>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
		<transition>
			<from>3</from><to>4</to>
			<read/>
			<pop>Z</pop>
			<push>Z</push>
		</transition>
	</automaton>
</structure>
